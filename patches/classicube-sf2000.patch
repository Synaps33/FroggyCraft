+   button that reuses the world name already chosen for this session. */
+static void Menu_SaveLevelNow(void* a, void* b) {
+	cc_string path; char pathBuffer[FILENAME_SIZE];
+	cc_result res;
+	if (!World.Name.length) {
+		Chat_AddRaw("&eNo world name yet - generate a level first");
+		return;
+	}
+	String_InitArray(path, pathBuffer);
+	String_Format1(&path, "maps/%s.cw", &World.Name);
+	res = Map_SaveTo(&path);
+	if (res) {
+		Chat_Add1("&eCould not save map: error %d", &res);
+	} else {
+		Chat_Add1("&aSaved map to: %s", &path);
+	}
