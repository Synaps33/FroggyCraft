+
+/* Nearest-neighbour upscale of the world buffer into the display buffer.
+   Both divisors are the fixed panel dimensions, never zero. */
+static void UpscaleWorldToDisplay(void) {
+    int sx, sy;
+    if (!worldW || !worldBmp.scan0 || !fb_bmp.scan0) return;
